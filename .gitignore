# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Temp / extraction artifacts
build/_tmp/
build/_raw/
*.log

# Book-scan intermediates: page rasters extracted from the PDFs (regenerate with
# build/_sources/davidson/ocr_tesseract.sh) and the compiled macOS OCR helper
# (build it from ocr_pdf.swift). The PDFs, DjVu XML, Vision OCR, per-page tesseract
# TSV, inventories and manifests stay tracked: they are what build/ and exwb/ read.
build/_sources/*/_pages_hi/
build/_sources/davidson/ocr_pdf
# Archive.org extras nothing reads (re-download: python scripts/fetch-sources davidson --all; P9-T10)
build/_sources/*/*_hocr.html
build/_sources/*/*_hocr_searchtext.txt*
build/_sources/*/*_hocr_pageindex.json*
build/_sources/*/*_page_numbers.json
build/_sources/*/*-djvu.txt
build/_sources/*/*.gz
build/_sources/davidson/grammar.txt

# OER cache (large; regenerated by build/fetch_oer.py) — manifest stays tracked
build/_oer/morphhb/
build/_oer/wiktionary/*.json
!build/_oer/wiktionary/index.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Bundled engine release artifacts (generated by scripts/release-course)
dist/

# Static site build output (scripts/build-site)
_site/

# Dev symlink: hub engine -> course dir (created by scripts/run; real vendoring
# happens at release via scripts/release-course)
courses/*/engine

# Do NOT ignore source/ PDFs (intentionally tracked source material)
!source/
# Public-repo additions (ADR-020): scan inputs are downloaded, never committed.
# Fetch them with: python scripts/fetch-sources davidson [--all]
build/_sources/davidson/*.pdf
build/_sources/davidson/*-djvu.xml
build/_sources/davidson/*-djvu.txt
build/_sources/davidson/*_hocr*
build/_sources/davidson/*_page_numbers.json
build/_sources/davidson/grammar.txt
build/_sources/davidson/*-vision-en.json
build/_sources/davidson/_tess/
build/_sources/*/*.part
