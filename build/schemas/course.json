{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course.json",
  "title": "Course manifest",
  "type": "object",
  "required": ["id", "title", "language", "level", "script", "units", "parts", "prerequisites", "knowledgeGraph"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+-[a-z]+-[a-z]+$" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 2 },
    "level": { "type": "string", "enum": ["A", "B", "C", "D", "E"] },
    "script": {
      "type": "object",
      "required": ["direction", "font", "fontFile", "keyboard", "translitScheme"],
      "properties": {
        "direction": { "enum": ["rtl", "ltr"] },
        "font": { "type": "string", "minLength": 1 },
        "fontFile": { "type": "string", "minLength": 1 },
        "keyboard": { "type": "string", "minLength": 1 },
        "translitScheme": { "type": "string", "minLength": 1 },
        "profile": { "enum": ["hebrew", "greek"], "description": "Script profile used by the graders (engine/script.js); default hebrew" },
        "code": { "type": "string", "minLength": 2, "description": "BCP 47 language of typed script answers (input lang attribute)" },
        "grading": {
          "type": "object",
          "description": "Greek only: strictness of typed answers (engine/greek.js levels and tolerances)",
          "properties": {
            "plain": { "enum": ["letters", "breathings", "full"] },
            "full": { "enum": ["letters", "breathings", "full"] },
            "movableNu": { "type": "boolean" },
            "elision": { "type": "boolean" },
            "clitics": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "n", "title", "part"],
        "properties": {
          "id": { "type": "string", "pattern": "^u\\d{2}$" },
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "part": { "type": "integer", "minimum": 1 },
          "textbookPage": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "title", "units"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "units": { "type": "array", "minItems": 2, "items": { "type": "integer" } }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["course", "level"],
        "properties": {
          "course": { "type": "string" },
          "level": { "enum": ["A", "B", "C", "D", "E"] }
        }
      }
    },
    "knowledgeGraph": { "type": "string", "minLength": 1 },
    "features": {
      "type": "object",
      "properties": {
        "parsing": { "type": "boolean" },
        "diagnostics": { "type": "boolean" },
        "reviewWarmup": { "type": "boolean" },
        "targetItems": { "type": "integer", "minimum": 1 },
        "reviewItems": { "type": "integer", "minimum": 0 },
        "authoredPerSession": { "type": "integer", "minimum": 1 },
        "ladderTarget": { "type": "integer", "minimum": 1, "description": "Right answers per ladder rung a unit needs: all of the book's exercises, topped up from the extra (corpus) items; without it every extra item is needed" },
        "vocabPerSession": { "type": "integer", "minimum": 0 },
        "unlockRung": { "type": "integer", "minimum": 1, "maximum": 9 },
        "wordLadder": { "type": "boolean" },
        "retries": { "type": "boolean" },
        "tests": { "type": "boolean" },
        "wordsPerSession": { "type": "integer", "minimum": 1 },
        "transliteration": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
