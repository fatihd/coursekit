{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbook-exercises.json",
  "title": "Workbook exercises (typed scaffolds)",
  "type": "object",
  "required": ["schema", "unit", "items"],
  "properties": {
    "schema": { "type": "string", "const": "workbook-exercises-v1.json" },
    "unit": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "n", "typeGuess", "confidence", "prompt", "body_raw", "answer_raw"],
        "properties": {
          "unit": { "type": "integer", "minimum": 1 },
          "n": { "type": "integer", "minimum": 1 },
          "typeGuess": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "prompt": { "type": "string" },
          "body_raw": { "type": "string" },
          "answer_raw": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}