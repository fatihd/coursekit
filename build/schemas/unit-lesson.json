{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit-lesson.json",
  "title": "Unit lesson content (typed blocks)",
  "type": "object",
  "required": ["schema", "unit", "title", "description", "teaches", "assumes", "blocks"],
  "properties": {
    "schema": { "type": "string", "const": "unit-lesson-v1.json" },
    "unit": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "teaches": { "type": "array", "items": { "type": "string" } },
    "assumes": { "type": "array", "items": { "type": "string" } },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "html"],
            "properties": {
              "type": { "const": "prose" },
              "caption": { "type": "string" },
              "html": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "refs"],
            "properties": {
              "type": { "const": "vocab" },
              "refs": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "html"],
            "properties": {
              "type": { "const": "callout" },
              "variant": { "type": "string" },
              "html": { "type": "string" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "caption", "columns", "rows"],
            "properties": {
              "type": { "const": "table" },
              "caption": { "type": "string" },
              "columns": { "type": "array", "items": { "type": "string" } },
              "rows": {
                "type": "array",
                "items": { "type": "array", "items": { "type": "string" } }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "caption", "columns", "rows"],
            "properties": {
              "type": { "const": "paradigm" },
              "caption": { "type": "string" },
              "columns": { "type": "array", "items": { "type": "string" } },
              "rows": {
                "type": "array",
                "items": { "type": "array", "items": { "type": "string" } }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "didYouKnow": { "type": "string" }
  },
  "additionalProperties": false
}
