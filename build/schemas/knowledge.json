{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge.json",
  "title": "Knowledge graph snapshot (prerequisites)",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": { "type": "string", "const": "knowledge-v1.json" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "language", "kind", "level", "unit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["lexeme", "morpheme", "paradigm", "grammar"] },
          "level": { "enum": ["A", "B", "C", "D", "E"] },
          "unit": { "type": "integer", "minimum": 1 },
          "scriptForm": { "type": "string" },
          "transliteration": { "type": "string" },
          "gloss": { "type": "string" },
          "category": { "type": "string" },
          "props": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}